<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Rentora — smart rent and property management for modern property owners.">
    <title>@ViewData["Title"]@(ViewData["Title"] != null ? " - " : "")Rentora — Smart Rent Management</title>
    <link rel="icon" type="image/png" href="~/assets/rentora-icon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="~/css/rentora.css" rel="stylesheet" asp-append-version="true">
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true">
    <script>
        (function () {
            const savedTheme = localStorage.getItem('rentora_theme');
            if (savedTheme === 'dark' || (!savedTheme && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                document.documentElement.setAttribute('data-theme', 'dark');
            } else {
                document.documentElement.setAttribute('data-theme', 'light');
            }
        })();
    </script>
</head>
<body>
    <!-- Main Top Navigation -->
    <nav class="navbar navbar-expand-lg fixed-top rentora-nav">
        <div class="container">
            <a class="navbar-brand brand p-0" asp-controller="Home" asp-action="Index" aria-label="Rentora home">
                <img src="~/assets/rentora-logo.png" alt="Rentora — Smart Rent Management" class="rentora-nav-logo logo-light" asp-append-version="true">
                <img src="~/assets/rentora-logo-dark.png" alt="Rentora — Smart Rent Management" class="rentora-nav-logo logo-dark" asp-append-version="true">
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav mx-auto align-items-lg-center">
                    <li class="nav-item"><a class="nav-link active" href="/#home">Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="/#features">Features</a></li>
                    <li class="nav-item"><a class="nav-link" href="/#pricing">Pricing</a></li>
                    <li class="nav-item"><a class="nav-link" href="/#testimonials">Testimonials</a></li>
                    <li class="nav-item"><a class="nav-link" href="/#faq">FAQ</a></li>
                    <li class="nav-item"><a class="nav-link" href="#supportModal" data-bs-toggle="modal" data-bs-target="#supportModal" role="button">Contact</a></li>
                </ul>
                <div class="nav-actions d-flex gap-2 align-items-center">
                    <button type="button" class="btn-theme-toggle" id="themeToggleBtn" aria-label="Toggle Dark Mode" title="Toggle Dark/Light Mode">
                        <i class="bi bi-moon-stars-fill theme-icon-moon"></i>
                        <i class="bi bi-sun-fill theme-icon-sun"></i>
                    </button>
                    <a class="btn btn-outline-primary btn-sm rounded-pill px-4" asp-controller="Account" asp-action="Login">Login</a>
                    <a class="btn btn-success btn-sm rounded-pill px-4" asp-controller="Account" asp-action="Register">Get Started Free <i class="bi bi-arrow-right"></i></a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content Area -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- Site Footer -->
    <footer class="site-footer">
        <div class="container footer-inner">
            <a class="navbar-brand brand p-0" asp-controller="Home" asp-action="Index" aria-label="Rentora">
                <img src="~/assets/rentora-logo.png" alt="Rentora — Smart Rent Management" class="rentora-footer-logo logo-light" asp-append-version="true">
                <img src="~/assets/rentora-logo-dark.png" alt="Rentora — Smart Rent Management" class="rentora-footer-logo logo-dark" asp-append-version="true">
            </a>
            <div class="footer-links">
                <a href="/#features">Features</a>
                <a href="/#pricing">Pricing</a>
                <a href="/#faq">About</a>
                <a href="#supportModal" data-bs-toggle="modal" data-bs-target="#supportModal" role="button">Contact</a>
            </div>
            <div class="social-links">
                <a href="#" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                <a href="#" aria-label="LinkedIn"><i class="bi bi-linkedin"></i></a>
                <a href="#" aria-label="YouTube"><i class="bi bi-youtube"></i></a>
                <a href="#" aria-label="X"><i class="bi bi-twitter-x"></i></a>
            </div>
            <small class="copyright">&copy; @DateTime.Now.Year Rentora. All rights reserved.</small>
        </div>
    </footer>

    <!-- Video / Product Demo Modal -->
    <div class="modal fade" id="demoModal" tabindex="-1" aria-labelledby="demoModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content demo-modal border-0 shadow-lg" style="border-radius: 20px; overflow: hidden;">
                <div class="modal-header border-0 pb-0 px-4 pt-4 d-flex justify-content-between align-items-center">
                    <div>
                        <h4 class="modal-title fw-bold" id="demoModalLabel" style="color: var(--navy);">Rentora Interactive Dashboard</h4>
                        <p class="text-muted small mb-0">High-performance real-time property, flat, tenant &amp; rent collection overview.</p>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4 text-center">
                    <img src="~/assets/dashboard-screen.jpg" alt="Rentora Smart Rent Management Live Dashboard" class="img-fluid rounded-3 shadow-sm border" asp-append-version="true" style="max-height: 75vh; object-fit: contain;">
                </div>
            </div>
        </div>
    </div>

    <!-- Support Question / Get in Touch Modal -->
    <div class="modal fade" id="supportModal" tabindex="-1" aria-labelledby="supportModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content support-modal-content border-0 shadow-lg">
                <div class="modal-header support-modal-header border-0 p-4 position-relative">
                    <div class="d-flex align-items-center gap-3">
                        <div class="support-header-icon-box">
                            <img src="~/assets/rentora-icon.png" alt="Rentora" class="support-header-brand-icon logo-light" asp-append-version="true" />
                            <img src="~/assets/rentora-icon-dark.png" alt="Rentora" class="support-header-brand-icon logo-dark" asp-append-version="true" />
                        </div>
                        <div>
                            <h4 class="modal-title fw-bold support-header-title mb-1" id="supportModalLabel">Get in Touch with Support</h4>
                            <p class="mb-0 support-header-desc small">Have questions or need assistance? Fill in your details and our specialists will respond within 5 minutes.</p>
                        </div>
                    </div>
                    <button type="button" class="btn-close support-header-close position-absolute top-0 end-0 m-4" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                
                <div class="modal-body p-4">
                    <!-- Form Container -->
                    <form id="supportInquiryForm" novalidate>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label for="supportFullName" class="form-label support-form-label">Full Name <span class="text-danger">*</span></label>
                                <input type="text" class="form-control support-form-control" id="supportFullName" placeholder="e.g. John Doe" required>
                                <div class="invalid-feedback">Please enter your full name.</div>
                            </div>
                            <div class="col-md-6">
                                <label for="supportEmail" class="form-label support-form-label">Email Address <span class="text-danger">*</span></label>
                                <input type="email" class="form-control support-form-control" id="supportEmail" placeholder="name@example.com" required>
                                <div class="invalid-feedback">Please enter a valid email address.</div>
                            </div>

                            <div class="col-md-6">
                                <label for="supportPhone" class="form-label support-form-label">Phone / WhatsApp Number <span class="text-danger">*</span></label>
                                <input type="tel" class="form-control support-form-control" id="supportPhone" placeholder="+880 18XXXXXXXX or +1 (555) 000-0000" required>
                                <div class="invalid-feedback">Please provide a contact number.</div>
                            </div>
                            <div class="col-md-6">
                                <label for="supportCompany" class="form-label support-form-label">Company / Property Name</label>
                                <input type="text" class="form-control support-form-control" id="supportCompany" placeholder="e.g. Greenwood Apartments / Property Name">
                            </div>

                            <div class="col-12">
                                <label for="supportSubject" class="form-label support-form-label">Subject / Short Summary <span class="text-danger">*</span></label>
                                <input type="text" class="form-control support-form-control" id="supportSubject" placeholder="e.g. How to automate monthly SMS rent receipts?" required>
                                <div class="invalid-feedback">Please specify a subject.</div>
                            </div>

                            <div class="col-12">
                                <label for="supportMessage" class="form-label support-form-label">Detailed Question &amp; Requirements <span class="text-danger">*</span></label>
                                <textarea class="form-control support-form-control" id="supportMessage" rows="3" placeholder="Please describe your question, specific requirements, or issue in detail..." required></textarea>
                                <div class="invalid-feedback">Please describe your question or issue.</div>
                            </div>
                        </div>

                        <div class="modal-footer support-modal-footer px-0 pt-4 pb-0 mt-4 border-top d-flex justify-content-between align-items-center flex-wrap gap-3">
                            <div class="support-privacy-notice text-muted small d-flex align-items-center">
                                <i class="bi bi-shield-check text-success fs-5 me-2"></i>
                                <span>Your information is kept strictly confidential &amp; answered within 5 mins.</span>
                            </div>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn btn-success rounded-pill px-4 fw-bold support-submit-btn shadow-sm">
                                    <i class="bi bi-send-fill me-1"></i> Submit Question
                                </button>
                            </div>
                        </div>
                    </form>

                    <!-- Success State Screen -->
                    <div id="supportSuccessState" class="d-none text-center py-4">
                        <div class="support-success-badge mb-3">
                            <i class="bi bi-check2-circle text-success"></i>
                        </div>
                        <h4 class="fw-bold support-success-title mb-2">Question Submitted Successfully!</h4>
                        <div class="support-ticket-pill mb-3">
                            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 fs-6 fw-bold">Ticket <span id="supportTicketId">#RT-7842</span></span>
                        </div>
                        <p class="support-success-desc text-muted mx-auto mb-4" style="max-width: 520px;">
                            Thank you, <strong id="supportSuccessName" class="text-dark">Property Owner</strong>. Your question has been routed to our dedicated rental management specialists. A confirmation has been sent to <strong id="supportSuccessEmail" class="text-dark">your email</strong>, and our team will get back to you within 5 minutes.
                        </p>
                        <button type="button" class="btn btn-success rounded-pill px-5 py-2 fw-bold" data-bs-dismiss="modal">
                            Done
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/rentora.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
