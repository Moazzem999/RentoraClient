<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Rentora — smart rent and property management for modern property owners.">
    <title>@ViewData["Title"]@(ViewData["Title"] != null ? " - " : "")Rentora — Smart Rent Management</title>
    <link rel="icon" type="image/png" href="~/assets/rentora-icon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="~/css/rentora.css" rel="stylesheet" asp-append-version="true">
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true">
    <script>
        (function () {
            const savedTheme = localStorage.getItem('rentora_theme');
            if (savedTheme === 'dark' || (!savedTheme && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                document.documentElement.setAttribute('data-theme', 'dark');
            } else {
                document.documentElement.setAttribute('data-theme', 'light');
            }
        })();
    </script>
</head>
<body>
    <!-- Main Top Navigation -->
    <nav class="navbar navbar-expand-lg fixed-top rentora-nav">
        <div class="container">
            <a class="navbar-brand brand p-0" asp-controller="Home" asp-action="Index" aria-label="Rentora home">
                <img src="~/assets/rentora-logo.png" alt="Rentora — Smart Rent Management" class="rentora-nav-logo logo-light" asp-append-version="true">
                <img src="~/assets/rentora-logo-dark.png" alt="Rentora — Smart Rent Management" class="rentora-nav-logo logo-dark" asp-append-version="true">
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav mx-auto align-items-lg-center">
                    <li class="nav-item"><a class="nav-link active" href="/#home">Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="/#features">Features</a></li>
                    <li class="nav-item"><a class="nav-link" href="/#pricing">Pricing</a></li>
                    <li class="nav-item"><a class="nav-link" href="/#testimonials">Testimonials</a></li>
                    <li class="nav-item"><a class="nav-link" href="/#faq">FAQ</a></li>
                </ul>
                <div class="nav-actions d-flex gap-2 align-items-center">
                    <button type="button" class="btn-theme-toggle" id="themeToggleBtn" aria-label="Toggle Dark Mode" title="Toggle Dark/Light Mode">
                        <i class="bi bi-moon-stars-fill theme-icon-moon"></i>
                        <i class="bi bi-sun-fill theme-icon-sun"></i>
                    </button>
                    <a class="btn btn-outline-primary btn-sm rounded-pill px-4" asp-controller="Account" asp-action="Login">Login</a>
                    <a class="btn btn-success btn-sm rounded-pill px-4" asp-controller="Account" asp-action="Register">Get Started Free <i class="bi bi-arrow-right"></i></a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content Area -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- Site Footer -->
    <footer class="site-footer">
        <div class="container footer-inner">
            <a class="navbar-brand brand p-0" asp-controller="Home" asp-action="Index" aria-label="Rentora">
                <img src="~/assets/rentora-logo.png" alt="Rentora — Smart Rent Management" class="rentora-footer-logo logo-light" asp-append-version="true">
                <img src="~/assets/rentora-logo-dark.png" alt="Rentora — Smart Rent Management" class="rentora-footer-logo logo-dark" asp-append-version="true">
            </a>
            <div class="footer-links">
                <a href="/#features">Features</a>
                <a href="/#pricing">Pricing</a>
                <a href="/#faq">About</a>
                <a href="/#get-started">Contact</a>
            </div>
            <div class="social-links">
                <a href="#" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                <a href="#" aria-label="LinkedIn"><i class="bi bi-linkedin"></i></a>
                <a href="#" aria-label="YouTube"><i class="bi bi-youtube"></i></a>
                <a href="#" aria-label="X"><i class="bi bi-twitter-x"></i></a>
            </div>
            <small class="copyright">&copy; @DateTime.Now.Year Rentora. All rights reserved.</small>
        </div>
    </footer>

    <!-- Video / Product Demo Modal -->
    <div class="modal fade" id="demoModal" tabindex="-1" aria-labelledby="demoModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content demo-modal border-0 shadow-lg" style="border-radius: 20px; overflow: hidden;">
                <div class="modal-header border-0 pb-0 px-4 pt-4 d-flex justify-content-between align-items-center">
                    <div>
                        <h4 class="modal-title fw-bold" id="demoModalLabel" style="color: var(--navy);">Rentora Interactive Dashboard</h4>
                        <p class="text-muted small mb-0">High-performance real-time property, flat, tenant &amp; rent collection overview.</p>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4 text-center">
                    <img src="~/assets/dashboard-screen.jpg" alt="Rentora Smart Rent Management Live Dashboard" class="img-fluid rounded-3 shadow-sm border" asp-append-version="true" style="max-height: 75vh; object-fit: contain;">
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/rentora.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
