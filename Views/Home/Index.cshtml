<section id="faq" class="faq-section section-pad">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-7">
                <span class="section-kicker">GOT QUESTIONS?</span>
                <h2>Frequently Asked Questions</h2>
                <p class="section-lead">Find answers to common questions about Rentora.</p>
                <div class="accordion rentora-accordion" id="faqAccordion">
                    <div class="accordion-item">
                        <h3 class="accordion-header">
                            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faq1" aria-expanded="true">
                                How does Rentora work?
                            </button>
                        </h3>
                        <div id="faq1" class="accordion-collapse collapse show" data-bs-parent="#faqAccordion">
                            <div class="accordion-body">
                                Create your buildings, add flats and tenants, then generate monthly bills and track rent collection from one dashboard.
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <h3 class="accordion-header">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq2">
                                Can I manage multiple buildings?
                            </button>
                        </h3>
                        <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                            <div class="accordion-body">
                                Yes. You can organize multiple buildings and manage the flats and tenants within each property.
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <h3 class="accordion-header">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq3">
                                Is my data secure?
                            </button>
                        </h3>
                        <div id="faq3" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                            <div class="accordion-body">
                                Rentora is designed with secure access and privacy in mind. Production security depends on your deployed backend and hosting configuration.
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <h3 class="accordion-header">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq4">
                                Can I cancel anytime?
                            </button>
                        </h3>
                        <div id="faq4" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                            <div class="accordion-body">
                                Yes. You can change or cancel your subscription at any time.
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <h3 class="accordion-header">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq5">
                                Do you provide customer support?
                            </button>
                        </h3>
                        <div id="faq5" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                            <div class="accordion-body">
                                Yes. Support is available, with priority and dedicated options on higher plans.
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="faq-card-interactive">
                    <div class="faq-glow-backdrop"></div>
                    
                    <div class="faq-badge-top">
                        <span class="pulse-indicator"></span>
                        <span>Support Team Online</span>
                    </div>

                    <h3 class="faq-card-title">Still have questions?</h3>
                    <p class="faq-card-desc">Can't find the answer you're looking for? Our dedicated rental management specialists are ready to assist you anytime.</p>

                    <div class="faq-metrics-grid">
                        <div class="faq-metric-item">
                            <div class="metric-icon"><i class="bi bi-lightning-charge-fill text-warning"></i></div>
                            <div class="metric-info">
                                <strong>&lt; 5 Mins</strong>
                                <small>Average Response</small>
                            </div>
                        </div>
                        <div class="faq-metric-item">
                            <div class="metric-icon"><i class="bi bi-shield-check text-success"></i></div>
                            <div class="metric-info">
                                <strong>99.8%</strong>
                                <small>Resolution Score</small>
                            </div>
                        </div>
                    </div>

                    <div class="faq-agent-stack">
                        <div class="avatar-group">
                            <span class="agent-avatar agent-1" title="Senior Support Specialist">AR</span>
                            <span class="agent-avatar agent-2" title="Property Onboarding Expert">TK</span>
                            <span class="agent-avatar agent-3" title="Technical Support Lead">NM</span>
                            <span class="agent-avatar agent-count">+5</span>
                        </div>
                        <div class="agent-text">
                            <strong>Instant Personal Help</strong>
                            <small>Friendly specialists available 24/7</small>
                        </div>
                    </div>

                    <div class="faq-action-buttons">
                        <button type="button" class="btn btn-success rounded-pill btn-faq-contact" data-bs-toggle="modal" data-bs-target="#supportModal">
                            <i class="bi bi-chat-dots-fill me-2"></i> Get in Touch
                        </button>
                        <button type="button" class="btn btn-outline-primary rounded-pill btn-faq-demo" data-bs-toggle="modal" data-bs-target="#demoModal">
                            <i class="bi bi-play-circle-fill me-2"></i> Watch Demo
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

