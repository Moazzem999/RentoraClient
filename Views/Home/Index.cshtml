@{
    ViewData["Title"] = "Home";
    var apiBaseUrl = ViewBag.ApiBaseUrl ?? "https://localhost:7148/api";
}

<section id="home" class="hero-section section-shell">
    <div class="container">
        <div class="hero-card">
            <div class="hero-copy">
                <span class="eyebrow">Smart Solution for Property Owners</span>
                <h1>Manage Your<br>Properties &amp; Rents<br>Smarter with <span>Rentora</span></h1>
                <p>Create multiple buildings, manage flats, track rents<br class="d-none d-md-block"> and get complete reports — all in one easy platform.</p>
                <div class="d-flex flex-wrap gap-3 hero-buttons">
                    <a asp-controller="Account" asp-action="Register" class="btn btn-success btn-lg rounded-pill">Start Free Trial <i class="bi bi-arrow-right ms-1"></i></a>
                    <button class="btn btn-outline-primary btn-lg rounded-pill" data-bs-toggle="modal" data-bs-target="#demoModal"><i class="bi bi-play-circle me-1"></i> Watch Demo</button>
                </div>
            </div>
            <div class="hero-art">
                <div class="spark spark-one">✳</div><div class="spark spark-two">✳</div>
                <img src="~/assets/modern-building-blended.png" alt="Modern Luxury Residential Building" class="building-art-modern" asp-append-version="true">
                
                <!-- Open Laptop Screen Mockup -->
                <div class="laptop-mockup-wrapper" title="Click to view Rentora Dashboard" data-bs-toggle="modal" data-bs-target="#demoModal">
                    <div class="laptop-mockup">
                        <!-- Laptop Screen (Lid) -->
                        <div class="laptop-lid">
                            <div class="laptop-camera"></div>
                            <div class="laptop-screen">
                                <img src="~/assets/dashboard-screen.jpg" alt="Rentora Smart Rent Management Dashboard" class="dashboard-img" asp-append-version="true">
                                <div class="laptop-glare"></div>
                            </div>
                        </div>
                        <!-- Laptop Base (Keyboard Deck) -->
                        <div class="laptop-base">
                            <div class="laptop-notch"></div>
                        </div>
                        <!-- Ambient Base Shadow -->
                        <div class="laptop-shadow"></div>
                    </div>
                </div>
            </div>
            <div class="hero-glow"></div>
        </div>

        <div class="quick-features row g-0 text-center">
            <div class="col"><i class="bi bi-buildings"></i><strong>Multiple<br>Buildings</strong></div>
            <div class="col"><i class="bi bi-house-door-fill"></i><strong>Flat Management</strong></div>
            <div class="col"><i class="bi bi-people-fill"></i><strong>Tenant Management</strong></div>
            <div class="col"><i class="bi bi-calendar2-check"></i><strong>Rent Collection</strong></div>
            <div class="col"><i class="bi bi-bar-chart-fill"></i><strong>Powerful Reports</strong></div>
        </div>
    </div>
</section>

