@{
    ViewData["Title"] = "Privacy Policy";
}

<section class="section-pad" style="min-height: 70vh; padding-top: 120px;">
    <div class="container">
        <div class="card p-4 p-md-5 border-0 shadow-sm" style="border-radius: 18px; border: 1px solid #dce8fa !important;">
            <span class="section-kicker">LEGAL &amp; COMPLIANCE</span>
            <h1 class="mt-2 mb-4" style="color: var(--navy); font-weight: 800;">Privacy Policy</h1>
            <p class="lead" style="color: #40577f;">At Rentora, we take data privacy and security seriously. This policy outlines how your information is collected, stored, and protected.</p>
            
            <hr class="my-4" style="border-color: #dce8fa;">

            <h4 class="fw-bold" style="color: var(--navy);">1. Information We Collect</h4>
            <p class="text-muted">We collect information you provide directly to us when creating a Rentora landlord or tenant account, such as your full name, email address, phone number, and building configuration details.</p>

            <h4 class="fw-bold mt-4" style="color: var(--navy);">2. How We Protect Your Data</h4>
            <p class="text-muted">All sensitive data is encrypted in transit and at rest. We implement industry-standard security protocols to ensure your property and financial records are safeguarded.</p>

            <h4 class="fw-bold mt-4" style="color: var(--navy);">3. Contact Us</h4>
            <p class="text-muted">If you have any questions about this Privacy Policy or your personal data, please contact our support team at <a href="mailto:support@rentora.com" class="text-primary fw-semibold">support@rentora.com</a>.</p>
            
            <div class="mt-4">
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary rounded-pill px-4">
                    <i class="bi bi-arrow-left me-1"></i> Back to Home
                </a>
            </div>
        </div>
    </div>
</section>
